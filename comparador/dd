## 2. Frontend en React: Implementación de Drag & Drop

Para que el usuario pueda cambiar el orden visualmente, te recomiendo instalar `@dnd-kit/sortable`. Es moderno y ligero.

### Componente de Lista Ordenable
```jsx
import React, { useState } from 'react';
import { DndContext, closestCenter } from '@dnd-kit/core';
import { arrayMove, SortableContext, verticalListSortingStrategy } from '@dnd-kit/sortable';
import { SortableItem } from './SortableItem'; // Componente hijo

const ListaOT = ({ datosIniciales }) => {
  const [items, setItems] = useState(datosIniciales);

  const handleDragEnd = (event) => {
    const { active, over } = event;

    if (active.id !== over.id) {
      setItems((items) => {
        const oldIndex = items.findIndex(i => i.idOTDatos === active.id);
        const newIndex = items.findIndex(i => i.idOTDatos === over.id);
        
        const nuevoOrden = arrayMove(items, oldIndex, newIndex);
        
        // AQUÍ: Llamas a tu API para guardar el nuevo orden
        guardarNuevoOrden(nuevoOrden);
        
        return nuevoOrden;
      });
    }
  };

  return (
    <DndContext collisionDetection={closestCenter} onDragEnd={handleDragEnd}>
      <SortableContext items={items.map(i => i.idOTDatos)} strategy={verticalListSortingStrategy}>
        {items.map(dato => (
          <SortableItem key={dato.idOTDatos} id={dato.idOTDatos} dato={dato} />
        ))}
      </SortableContext>
    </DndContext>
  );
};
```

