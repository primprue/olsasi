<!-- prebalance.hbs -->
<html>

<head>
    <style>
        @page {
            size: A4 landscape;
            margin: 5mm;
        }

        /* Definimos una variable para cambiar el tamaño en un solo lugar */
        :root {
            --font-size-table: 8pt;
        }

        body {
            font-family: sans-serif;
            font-size: var(--font-size-table);
            margin: 0;
            padding: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        /* Aplicamos el tamaño directamente a las celdas para evitar herencias */
        /*  font-size: var(--font-size-table) !important;*/
        th,
        td {
            border: 0.5px solid #0f4aecad;
            padding: 2px;
            /* Padding reducido */
            text-align: right;
            overflow: hidden;
            font-size: 7pt;
        }

        th {
            background: #2c3e50;
            color: white;
            border: 1px solid #ddd;
            text-align: center;
        }

        /* Primera y última columna */
        th:first-child,
        td:first-child {
            width: 13%;
            text-align: left;
        }

        th:last-child,
        td:last-child {
            width: 8%;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <table>
        <thead>
            <tr>
                <th>Detalle</th>
                {{#each mesesEncabezado}}
                <th>{{this}}</th>
                {{/each}}
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each filas}}
            <tr>
                <td>{{this.detalle}}</td>

                {{!-- Iteramos sobre el array de valores de meses --}}
                {{#each this.valoresMeses}}
                <td>{{formatoMoneda this}}</td>
                {{/each}}

                {{!-- Formateamos el total de la fila --}}
                <td>{{formatoMoneda this.total}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>

</html>